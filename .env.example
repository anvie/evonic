# Evonic LLM Evaluator - Environment Variables
# Copy this file to .env and fill in your values

# LLM Configuration (OpenAI-compatible endpoint)
# For OpenRouter: https://openrouter.ai/api/v1
# For local LLM (llama.cpp, Ollama, etc): http://localhost:8080/v1
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=qwen/qwen-3.5-4B
LLM_TIMEOUT=120
LLM_MAX_TOKENS=32768
LLM_CONTEXT_LENGTH=0
LLM_PROMPT_BUFFER=2048

# Two-Pass Extraction (PASS1: generate answer, PASS2: extract final answer)
TWO_PASS_ENABLED=1
TWO_PASS_TEMPERATURE=0.0

# Anthropic API (for improver module - analysis & training data generation)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Flask Configuration
SECRET_KEY=your-secret-key-here
HOST=0.0.0.0
PORT=8080
DEBUG=1

# Service management (optional). Leave blank for Evonic's built-in process manager.
# With these values, restart/stop actions run `systemctl restart|stop evonic`.
SERVICE_SYSTEM=
SYSTEMD_SERVICE_NAME=

# Authentication
# Use `./evonic pass` to set new password.
ADMIN_PASSWORD_HASH=
# Cloudflare Turnstile (optional, shown on login page when configured)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Real-time Log Verbosity (set to 1 to include full content in live logs)
LOG_FULL_THINKING=0
LOG_FULL_RESPONSE=0

# Raw LLM API call logging (writes every request/response to markdown file)
LLM_API_LOG_ENABLED=0
LLM_API_LOG_FILE=logs/llm_api_calls.md

# Event stream log file (agent runtime events: processing_started, llm_thinking, tool_executed, etc.)
EVENT_LOG_FILE=logs/events.log

# Suppress noisy third-party logs from console (still written to log files).
# Comma-separated fnmatch patterns (e.g. apscheduler.*, telethon.*)
EVONIC_LOG_CONSOLE_QUIET=apscheduler.*

# Sub-agent idle TTL in seconds (default: 1800 = 30 minutes, configurable via env)
EVONIC_SUBAGENT_IDLE_TTL=1800

# Session Archive: when enabled the session data will be archived before it deleted in active db
EVONIC_SESSION_ARCHIVE=0

# Maximum seconds to wait for each read-only tool in a parallel batch. The timer
# starts when the tool is submitted; valid values are clamped to 1-3600 seconds.
AGENT_PARALLEL_TOOL_WAIT_TIMEOUT=300

# Same-turn active context projection. Shadow mode measures the bounded projection
# but keeps canonical messages on the provider request during the initial rollout.
# Supported controls: off, shadow, enforced (currently shadow-only at runtime).
ACTIVE_CONTEXT_MODE=enforced
ACTIVE_CONTEXT_SOFT_TOKENS=12000
ACTIVE_CONTEXT_RECENT_GROUPS=2
ACTIVE_CONTEXT_RECEIPT_MAX_CHARS=4000

# ── Tool guards ───────────────────────────────────────────────────────
# Root filesystem scan guard: auto-rejects `find /` and `tree /` (a full-root
# scan can stall the turn) so the agent explores a narrower path instead. Separate from the
# per-agent Safety Checker toggle. Also toggleable in System > Settings
# (root_fs_scan_guard_enabled); this env var force-disables the guard and
# wins over that setting. Set to 1 to disable.
# RFS_GUARD_DISABLED=1

# Long-running command guard: blocks compile/build commands (make, cargo,
# npm run build, ...) that would exceed the bash timeout, and asks for the
# tmux/screen wrapper instead. Also toggleable in System → Settings.
# Set to 1 to disable.
# LR_GUARD_DISABLED=1

# ── Memory system ──────────────────────────────────────────────────────────
# Global defaults; can be overridden per-agent in Agent → Advanced Settings.
# Retrieval engine: 'evomem' (semantic + knowledge graph) or 'fts5' (keyword).
EVONIC_MEMORY_ENGINE=evomem
# KB organizer (how conversation knowledge is filed into the vault):
#   agentic     = sub-agent explores the vault & links docs (best quality, more tokens)
#   non-agentic = single LLM author call (cheaper, no exploration)
#   sefton      = non-agentic filing via evomem search (~5 min cooldown) + nightly
#                 KB Janitor sub-agent that tidies the vault (SEFTON =
#                 Search Engine First, Tidy On Night)
#   off         = do not file anything
EVOMEM_KB_ORGANIZER=sefton
# Daily local time for the SEFTON KB Janitor, in HH:MM format. Default: 03:00.
# EVOMEM_KB_ORGANIZER_NIGHTLY_TIME=03:00
# Minimum seconds between KB organizer filing runs per agent (persistent cooldown,
# survives restart). Filing costs tokens, so it won't run again within this window.
# Default 1800 = 30 minutes.
EVOMEM_KB_ORGANIZER_MIN_INTERVAL_SECONDS=1800
# SEFTON mode: minimum seconds between non-agentic filing runs. Default 300 = 5 min.
# EVOMEM_KB_SEFTON_FILING_INTERVAL=300
# Debounce delay (seconds) before evomem sync fires after a KB doc is modified.
# Coalesces rapid edits into a single sync. Default 5.
# EVOMEM_SYNC_DEBOUNCE=5

# Boot-gate probe: set to 1 to make `import app` return immediately without starting
# channels, the scheduler, or app.run(). Used by the update pipeline's smoke test to
# verify the new code imports cleanly without touching the live server's port or DB
# connections. Not intended for production use.
# EVONIC_SMOKE_TEST=

# Memory engine: "evomem" (default, graph-backed; requires the evomem binary) or
# "fts5" (SQLite full-text fallback, no binary needed). The installer fetches the
# evomem binary automatically; otherwise run `evonic evomem install`. When evomem
# is selected but the binary is absent, the runtime transparently uses FTS5.
EVONIC_MEMORY_ENGINE=evomem
# Pin a specific evomem release tag (default: latest). e.g. EVOMEM_VERSION=v0.2.0
# EVOMEM_VERSION=
# Override the evomem binary path (default: shared/bin/evomem).
# EVOMEM_BINARY=

# ── Cross-Agent Artifact Sharing ────────────────────────────────────────────────
# Enables the `share_artifact` agent tool and the artifact-share download plugin.
# A `share_artifact` call either returns a direct host-local path (when both
# agents provably run on the same Evonic host) or a short-lived, single-use
# tokenized HTTPS download URL. Messages never carry binary data.
# Valid values: 1/0, True/False, Yes/No, On/Off. Default: 1 (enabled).
# ARTIFACT_SHARE_ENABLED=1
# Lifetime of a tokenized download URL in seconds. Default: 300 (5 minutes).
# ARTIFACT_SHARE_TOKEN_TTL=300
# Maximum size (MB) of an artifact that may be shared. Default: 100.
# ARTIFACT_SHARE_MAX_MB=100
# Directory holding opaque server-side snapshots of shared artifacts.
# Default: <APP_ROOT>/data/spool/artifact_share
# ARTIFACT_SHARE_SPOOL_DIR=
# Maximum total size (MB) the spool may hold before new shares are refused.
# Default: 2048 (2 GB).
# ARTIFACT_SHARE_SPOOL_QUOTA_MB=2048
# Optional comma-separated allowlist of artifact extensions, e.g. ".pdf,.png,.zip".
# Empty (default) allows any file type.
# ARTIFACT_SHARE_ALLOWED_EXTENSIONS=
# Public origin used to build token download links (no trailing slash). Set this
# to the externally reachable URL in production; when unset the sender tool
# falls back to http://127.0.0.1:8080.
# EVONIC_PUBLIC_URL=
# ────────────────────────────────────────────────────────────────────────────────

# ── Docker Sandbox ──────────────────────────────────────────────────────
# When enabled (default), the main agent's Docker sandbox container is keyed
# by agent_id instead of session_id, runs with --restart=unless-stopped, and
# is stopped but *not* removed on `evonic stop`.  Installed packages and
# container state therefore survive across sessions and across restarts.
# Sub-agents and explorer sub-workspaces remain session-scoped.
# Valid values: 1/0, True/False, Yes/No, On/Off.
# SANDBOX_PERSISTENT_CONTAINER_ENABLED=1
# ───────────────────────────────────────────────────────────────────────

# Default agent avatars (used when no image was uploaded). Generated from the agent's name.
# Styles: marble | beam | pixel | sunset | ring | bauhaus
# AVATAR_STYLE=beam
# Optional palette, comma-separated #RRGGBB (default: built-in palette)
# AVATAR_COLORS=#6366F1,#8B5CF6,#EC4899,#F59E0B,#10B981
